#!/bin/sh
set -eu
TARGET="${3:-/}"
ROOT="${TARGET%/}"
APP="$ROOT/Applications/vRemote.app"
DRIVER="$ROOT/Library/Audio/Plug-Ins/HAL/vRemoteDriver.driver"
[ -x "$APP/Contents/MacOS/vRemote" ]
[ -x "$DRIVER/Contents/MacOS/BlackHole" ]
/usr/bin/codesign --verify --deep --strict "$APP"
/usr/bin/codesign --verify --deep --strict "$DRIVER"
/usr/sbin/chown -R root:wheel "$DRIVER"
/usr/bin/find "$DRIVER" -type d -exec /bin/chmod 755 {} +
/usr/bin/find "$DRIVER" -type f -exec /bin/chmod 644 {} +
/bin/chmod 755 "$DRIVER/Contents/MacOS/BlackHole"

if [ "$TARGET" = "/" ]; then
  if /usr/bin/pgrep -x coreaudiod >/dev/null; then
    /usr/bin/killall -TERM coreaudiod
  fi
  # Launching a GUI is optional (e.g. remote/unattended installation); failure is visible but does not invalidate installation.
  console_user=$(/usr/bin/stat -f '%Su' /dev/console)
  if [ -n "$console_user" ] && [ "$console_user" != "root" ] && [ "$console_user" != "loginwindow" ]; then
    console_uid=$(/usr/bin/id -u "$console_user")
    if ! /bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" /usr/bin/open -n "$APP"; then
      echo "vRemoter installed; launch /Applications/vRemote.app manually." >&2
    fi
  fi
fi
